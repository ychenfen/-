# 复制为 ~/dy2text/dy2text.env 并 chmod 600。TOKEN 就是网页访问密码。
DOUYIN_SERVER_TOKEN=REDACTED_REPLACE_LOCALLY
DOUYIN_SERVER_HOST=127.0.0.1
DOUYIN_SERVER_PORT=8765
DOUYIN_DATA_DIR=/home/ubuntu/dy2text/data
DOUYIN_BACKENDS=browser,iesdouyin,ytdlp
DOUYIN_COOKIES_FILE=/home/ubuntu/dy2text/secrets/douyin-anon-cookies.txt
# 只用于创建匿名浏览器会话；不要填需要登录或私密的作品。
DOUYIN_COOKIE_SEED_URL=https://www.douyin.com/video/7685682624978832691
# Playwright 默认下载 headless-shell；若部署的是完整 Chromium，显式指定它。
DOUYIN_CHROMIUM_EXECUTABLE=/home/ubuntu/dy2text/playwright-browsers/chromium-1243/chrome-linux64/chrome
DOUYIN_KEEP_VIDEO=1
DOUYIN_VIDEO_TTL_HOURS=24
DOUYIN_VIDEO_MAX_GB=2
DOUYIN_ASR_MODEL=sherpa-sensevoice
DOUYIN_SHERPA_MODEL_DIR=/home/ubuntu/dy2text/models/sensevoice
DOUYIN_ASR_THREADS=2
DOUYIN_FFMPEG=/home/ubuntu/dy2text/venv/bin/ffmpeg
DOUYIN_MIN_INTERVAL=3
PYTHONPATH=/home/ubuntu/dy2text/app
