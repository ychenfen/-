# 复制为 ~/dy2text/dy2text.env 并 chmod 600。TOKEN 就是网页访问密码。
DOUYIN_SERVER_TOKEN=REDACTED_REPLACE_LOCALLY
DOUYIN_SERVER_HOST=127.0.0.1
DOUYIN_SERVER_PORT=8765
DOUYIN_DATA_DIR=/home/ubuntu/dy2text/data
DOUYIN_BACKENDS=iesdouyin,ytdlp
DOUYIN_ASR_MODEL=sherpa-sensevoice
DOUYIN_SHERPA_MODEL_DIR=/home/ubuntu/dy2text/models/sensevoice
DOUYIN_ASR_THREADS=2
DOUYIN_FFMPEG=/home/ubuntu/dy2text/venv/bin/ffmpeg
DOUYIN_MIN_INTERVAL=3
PYTHONPATH=/home/ubuntu/dy2text/app
